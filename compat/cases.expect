### duplicate-attr
rnix-accepts    { a = 1; a = 2; }
    nix: error: attribute 'a' already defined at «stdin»:1:3
rnix-accepts    let a = 1; a = 2; in a
    nix: error: attribute 'a' already defined at «stdin»:1:5
rnix-accepts    { a = 1; ${"a"} = 2; }
    nix: error: attribute 'a' already defined at «stdin»:1:3
rnix-accepts    { a.b = 1; a = 2; }
    nix: error: attribute 'a' already defined at «stdin»:1:3
rnix-accepts    { a = { b = 1; }; a.b = 2; }
    nix: error: attribute 'a.b' already defined at «stdin»:1:9
rnix-accepts    { inherit a; a = 1; }
    nix: error: attribute 'a' already defined at «stdin»:1:11
same            { a = { }; a = { }; }

### duplicate-formal
rnix-accepts    { x, x }: x
    nix: error: duplicate formal function argument 'x'
rnix-accepts    x@{ x }: x
    nix: error: duplicate formal function argument 'x'
rnix-accepts    { x }@x: x
    nix: error: duplicate formal function argument 'x'

### dynamic-name
rnix-accepts    let ${a} = 1; in a
    nix: error: dynamic attributes not allowed in let
rnix-accepts    let "${a}" = 1; in a
    nix: error: dynamic attributes not allowed in let
rnix-accepts    { inherit ${a}; }
    nix: error: dynamic attributes not allowed in inherit
rnix-accepts    { inherit "${a}"; }
    nix: error: dynamic attributes not allowed in inherit
same            let ${"a"} = 1; in a
same            { inherit ${"a"}; }

