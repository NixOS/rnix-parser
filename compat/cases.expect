nix-instantiate (Nix) 2.35.3

### zero-dot
tree-differs    0.a
    nix: (0).a
    rnix: (0 a)
tree-differs    0.e1
    nix: (0).e1
    rnix: 0
tree-differs    x: x.a 0.a
    nix: (x: ((x).a (0).a))
    rnix: (x: ((x).a 0 a))
rnix-accepts    [ 0. ]
    nix: error: syntax error, unexpected ']', expecting identifier or 'or' or '${' or '"'

### float-exponent
rnix-rejects    1.5e
    rnix: unexpected TOKEN_ERROR at 0..4, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    1.5ea
    rnix: unexpected TOKEN_ERROR at 0..4, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    .5e != a
    rnix: unexpected TOKEN_ERROR at 0..3, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    f 1.e
    rnix: unexpected token at 2..5

### slash-operand
rnix-rejects    a/(b)
    rnix: unexpected TOKEN_ERROR at 0..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    2/(3)
    rnix: unexpected TOKEN_ERROR at 0..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    a/"b"
    rnix: unexpected TOKEN_ERROR at 0..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    a/[ b ]
    rnix: unexpected TOKEN_ERROR at 0..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    c/{ }
    rnix: unexpected TOKEN_ERROR at 0..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    r/!b
    rnix: unexpected TOKEN_ERROR at 0..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]

### not-operand
rnix-rejects    a + !b
    rnix: unexpected TOKEN_INVERT at 4..5, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    -!a
    rnix: unexpected TOKEN_INVERT at 1..2, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    a * !b
    rnix: unexpected TOKEN_INVERT at 4..5, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]
rnix-rejects    "" + !0
    rnix: unexpected TOKEN_INVERT at 5..6, wanted any of [TOKEN_L_PAREN, TOKEN_REC, TOKEN_L_BRACE, TOKEN_L_BRACK, TOKEN_STRING_START, TOKEN_IDENT]

### legacy-let
rnix-rejects    f let { body = 1; }
    rnix: unexpected token at 2..19
rnix-rejects    let { body = 1; }.body
    rnix: unexpected token at 17..22
rnix-rejects    let { } == x
    rnix: unexpected token at 8..12
tree-differs    e: let { } or
    nix: (e: ((rec { }).body or))
    rnix: ((e: (rec { }).body) or)

### comment-cr
tree-differs    f # c⟨CR⟩x
    nix: (f x)
    rnix: f
rnix-rejects    # c⟨CR⟩x
    rnix: unexpected end of file
tree-differs    1 # a⟨CR⟩+ 2
    nix: (1 + 2)
    rnix: 1

### string-cr
string-differs  "a⟨CR⟩b"
    literal: "a⟨CR⟩b"
    nix: "a\nb"
    rnix: "a\rb"
string-differs  "a⟨CR⟩⟨LF⟩b"
    literal: "a⟨CR⟩⟨LF⟩b"
    nix: "a\nb"
    rnix: "a\r\nb"
same            ''a⟨CR⟩⟨LF⟩b''

### indented-escape
string-differs  ''  ''\n ''
    literal: ''  ''\n ''
    nix: "\n"
    rnix: "\n "
string-differs  ''''\⟨LF⟩ ''
    literal: ''''\⟨LF⟩ ''
    nix: "\n "
    rnix: "\n"
string-differs  ''  ''\⟨LF⟩a⟨TAB⟩''
    literal: ''  ''\⟨LF⟩a⟨TAB⟩''
    nix: "\na\t"
    rnix: "  \na\t"

### nul-end
rnix-rejects    a⟨NUL⟩b
    rnix: unexpected token at 1..3
rnix-rejects    a⟨NUL⟩b ) c
    rnix: unexpected token at 1..7

### lambda-operand
rnix-accepts    f x: x
    nix: error: syntax error, unexpected ':', expecting end of file
rnix-accepts    1 + x: x
    nix: error: syntax error, unexpected ':', expecting end of file
rnix-accepts    [ x: x ]
    nix: error: syntax error, unexpected ':'
rnix-accepts    [ { a }: a ]
    nix: error: syntax error, unexpected '}', expecting '.' or '='
rnix-accepts    { } { }: x
    nix: error: syntax error, unexpected ':', expecting end of file

### mixed-pipes
rnix-accepts    a |> b <| c
    nix: error: syntax error, unexpected '<|', expecting end of file
rnix-accepts    a <| b |> c
    nix: error: syntax error, unexpected '|>', expecting end of file

### unclosed-paren
rnix-accepts    (a ]
    nix: error: syntax error, unexpected ']', expecting ')'
rnix-accepts    (a }
    nix: error: syntax error, unexpected '}', expecting ')'
rnix-accepts    (a ;
    nix: error: syntax error, unexpected ';', expecting ')'

### indented-string-name
rnix-accepts    a.''b''
    nix: error: syntax error, unexpected start of an indented string, expecting identifier or 'or' or '${' or '"'
rnix-accepts    { ''a'' = 1; }
    nix: error: syntax error, unexpected start of an indented string, expecting 'inherit'
rnix-accepts    { inherit ''a''; }
    nix: error: syntax error, unexpected start of an indented string
rnix-accepts    let ''a'' = 1; in a
    nix: error: syntax error, unexpected start of an indented string, expecting 'in' or 'inherit'
rnix-accepts    a ? ''b''
    nix: error: syntax error, unexpected start of an indented string, expecting identifier or 'or' or '${' or '"'

### search-path
rnix-accepts    </>
    nix: error: syntax error, unexpected '<'
rnix-accepts    <a/>
    nix: error: syntax error, unexpected '<'
rnix-accepts    <a/b/>
    nix: error: syntax error, unexpected '<'

### number-range
rnix-accepts    9223372036854775808
    nix: error: invalid integer '9223372036854775808'
rnix-accepts    1.e400
    nix: error: invalid float '1.e400'
rnix-accepts    5.0e-324
    nix: error: invalid float '5.0e-324'

### nul
rnix-accepts    "a⟨NUL⟩b"
    nix: error: input string 'a␀b' cannot be represented as Nix string because it contains null bytes
rnix-accepts    ''a⟨NUL⟩b''
    nix: error: input string 'a␀b' cannot be represented as Nix string because it contains null bytes

### whitespace
rnix-accepts    a⟨U+000C⟩b
    nix: error: syntax error, unexpected invalid token, expecting end of file
rnix-accepts    a⟨U+000B⟩b
    nix: error: syntax error, unexpected invalid token, expecting end of file
rnix-accepts    a⟨U+00A0⟩b
    nix: error: syntax error, unexpected invalid token, expecting end of file
rnix-accepts    a⟨U+2028⟩b
    nix: error: syntax error, unexpected invalid token, expecting end of file

### duplicate-attr
rnix-accepts    { a = 1; a = 2; }
    nix: error: attribute 'a' already defined at «stdin»:2:3
rnix-accepts    let a = 1; a = 2; in a
    nix: error: attribute 'a' already defined at «stdin»:2:5
rnix-accepts    { a = 1; ${"a"} = 2; }
    nix: error: attribute 'a' already defined at «stdin»:2:3
rnix-accepts    { a.b = 1; a = 2; }
    nix: error: attribute 'a' already defined at «stdin»:2:3
rnix-accepts    { a = { b = 1; }; a.b = 2; }
    nix: error: attribute 'a.b' already defined at «stdin»:2:9
rnix-accepts    { inherit a; a = 1; }
    nix: error: attribute 'a' already defined at «stdin»:2:11
same            { a = { }; a = { }; }

### duplicate-formal
rnix-accepts    { x, x }: x
    nix: error: duplicate formal function argument 'x'
rnix-accepts    x@{ x }: x
    nix: error: duplicate formal function argument 'x'
rnix-accepts    { x }@x: x
    nix: error: duplicate formal function argument 'x'

### dynamic-name
rnix-accepts    let ${a} = 1; in a
    nix: error: dynamic attributes not allowed in let
rnix-accepts    let "${a}" = 1; in a
    nix: error: dynamic attributes not allowed in let
rnix-accepts    { inherit ${a}; }
    nix: error: dynamic attributes not allowed in inherit
rnix-accepts    { inherit "${a}"; }
    nix: error: dynamic attributes not allowed in inherit
same            let ${"a"} = 1; in a
same            { inherit ${"a"}; }

### tricky
same            1e3
same            -./a
same            1 -./a
same            00.5
same            01.5
same            .5
same            1.
same            1..2
same            a.5
same            a-b
same            a'
same            x:x:x
same            http://example.org/a?b=c#d
same            <nixpkgs/lib>
same            ./a/${b}c
same            ~/a
same            f a or
same            map or [ ]
same            a.b or c or
same            a ? b ? c
same            !a + b
same            -a.b or c
same            a < b == c
same            a |> b |> c
same            a <| b <| c
same            x: x |> f
same            "$${a}"
same            ''$${a}''
same            ''a''$b''
same            9223372036854775807
both-reject     ./a//b
    nix: error: syntax error, unexpected end of path, expecting '${'
